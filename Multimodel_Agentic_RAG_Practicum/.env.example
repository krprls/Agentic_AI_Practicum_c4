# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your values.  NEVER commit .env
# ---------------------------------------------------------------

# LLM provider: "gemini" (default for development) or "ollama" (100% open-source local)
LLM_PROVIDER=gemini

# Google Gemini — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Ollama (optional, open-source models) — install from https://ollama.com, then `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Open-source local embedding model (HuggingFace, auto-downloaded on first run, ~130 MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval / chunking
TOP_K=8
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Optional: HuggingFace token (only needed for gated models; bge-small is public)
# HF_TOKEN=
